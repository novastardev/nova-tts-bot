# ============================================================
# 🔊 Nova TTS Bot — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Then edit .env with your actual values

# --- Telegram Bot ---
# Create a bot via @BotFather on Telegram. Get the API token.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- TTS API ---
# Your TTS.ai API key (or whichever TTS service you use)
TTS_API_KEY=your_tts_api_key_here

# --- Access Control ---
# JSON array of allowed Telegram Chat IDs.
# Users must be added here before they can use the bot.
# Find a user's Chat ID by sending /start to your bot and
# checking the logs, or by talking to @userinfobot on Telegram.
ALLOWED_CHAT_IDS=[123456789, 987654321]

# --- Bot Owner ---
# Your Telegram username — shown in "Access Denied" messages.
BOT_OWNER_HANDLE=@novastardev

# --- Monitor ---
# Timezone for the monitor dashboard clock (IANA format).
# Examples: Africa/Douala, America/New_York, Europe/London, Asia/Karachi
# Leave blank for UTC.
TZ=Africa/Douala

# --- Public mode (anyone can use the bot) ---
# true  = open to everyone (rate limits protect your credits)
# false = only ALLOWED_CHAT_IDS can use it
PUBLIC_MODE=false

# Your own Telegram user ID (for /stats command and new-user notifications)
OWNER_CHAT_ID=

# --- Public-mode limits ---
# Set RATE_LIMIT_ENABLED=true to turn on cooldown + daily caps
# (off by default so open-source users can test freely)
RATE_LIMIT_ENABLED=false
MAX_TEXT_LENGTH=500
COOLDOWN_SECONDS=15
DAILY_LIMIT=10
